/**
 * Создаёт опрос «Realtika — отзыв агента» из 8 коротких Google Форм (блоков) и одну таблицу для ответов.
 * Каждый блок на 2–5 минут: шаги сценария в описании формы, вопросы сразу после него.
 * Агент проходит блоки по одному, когда удобно. Ответы связываются по имени.
 * Как запустить: script.google.com → «Новый проект» → вставить этот код вместо пустого →
 * сохранить → вверху выбрать функцию createRealtikaForms → «Выполнить» → разрешить доступ.
 * Скрипт сам вставит ссылки на формы в документ с инструкцией (вместо {{БЛОК 1}} … {{БЛОК 8}}).
 * Ссылки на формы и таблицу также появятся внизу, в «Журнале выполнения».
 */
function createRealtikaForms() {
  const SITE = 'https://aptemkal.github.io/Realtika/';
  const TEST_DOC_ID = '1FnQ35BDs2002mK1Za78hVfX4F-aRXoA63qGTJTTtVJ0';
  const LOGIN = 'Сайт: ' + SITE + '\nВход: «Войти» → нажмите на демо-аккаунт «Анна Ким, агент» (пароль demo).';

  const sheet = SpreadsheetApp.create('Realtika — ответы агентов');
  const links = [];

  // Один блок = одна форма. Имя первым вопросом, чтобы склеить ответы одного человека из разных блоков
  function block(n, title, minutes, steps, build) {
    const form = FormApp.create('Realtika · ' + n + ' из 8 · ' + title);
    form.setDescription(minutes + ' мин.' + (steps ? '\n\n' + steps : '') + '\n\nКритика ценнее комплиментов. Все данные на сайте вымышленные, нажимайте смело.');
    form.setConfirmationMessage('Спасибо! Следующий блок можно пройти когда удобно, хоть завтра.');
    form.addTextItem().setTitle('Ваше имя').setHelpText('Чтобы связать ответы из разных блоков').setRequired(true);
    build(form);
    form.setDestination(FormApp.DestinationType.SPREADSHEET, sheet.getId());
    // Новые формы Google иногда создаёт неопубликованными — публикуем и открываем приём ответов
    try { form.setPublished(true); } catch (e) { /* метода нет в старых версиях — форма уже опубликована */ }
    form.setAcceptingResponses(true);
    links.push({ n: n, title: title, url: form.getPublishedUrl(), edit: form.getEditUrl() });
  }
  const text = (f, t, help) => { const i = f.addParagraphTextItem().setTitle(t); if (help) i.setHelpText(help); return i; };
  const scale = (f, t, lo, hi) => f.addScaleItem().setTitle(t).setBounds(1, 5).setLabels(lo, hi);

  block(1, 'Знакомство', 2, 'Сайт открывать не нужно, пара вопросов о вашей работе.', f => {
    f.addMultipleChoiceItem().setTitle('Ваша роль')
      .setChoiceValues(['Агент', 'Руководитель отдела продаж', 'Директор']).showOtherOption(true).setRequired(true);
    f.addTextItem().setTitle('Сколько лет в недвижимости?');
    f.addMultipleChoiceItem().setTitle('Сколько агентов в агентстве?')
      .setChoiceValues(['1–5', '6–20', '21–50', 'Больше 50']);
    f.addCheckboxItem().setTitle('С чем работаете?')
      .setChoiceValues(['Вторичка', 'Новостройки', 'Аренда', 'Загородная']).showOtherOption(true);
    f.addCheckboxItem().setTitle('Где сейчас ведёте клиентов?')
      .setChoiceValues(['amoCRM', 'Битрикс24', 'Excel или Google Таблицы', 'Мессенджеры и блокнот']).showOtherOption(true);
    f.addMultipleChoiceItem().setTitle('Сколько времени в день уходит на заполнение CRM или таблиц?')
      .setChoiceValues(['Меньше 15 минут', '15–30 минут', '30–60 минут', 'Больше часа']);
    f.addMultipleChoiceItem().setTitle('С какого устройства будете проходить тест?')
      .setChoiceValues(['Телефон', 'Компьютер', 'Оба']);
  });

  block(2, 'Новый клиент из переписки', 3, LOGIN + '\n\n' +
    '1. Нажмите «+ Сделка из переписки» сверху.\n' +
    '2. Пример сообщения клиента уже вставлен, нажмите «Разобрать». Можно вставить свою переписку, только без реальных телефонов.\n' +
    '3. Проверьте, что ИИ заполнил в полях, и нажмите «Создать сделку».', f => {
    scale(f, 'Насколько точно ИИ разобрал сообщение?', 'Мимо', 'Точно');
    scale(f, 'Быстрее ли это, чем вы заводите клиента сейчас?', 'Медленнее', 'Намного быстрее');
    text(f, 'Что ИИ разобрал неправильно или пропустил?');
    text(f, 'Теряли клиентов, потому что забыли написать или перезвонить? Как часто?');
  });

  block(3, 'Сделка по этапам', 5, LOGIN + '\n\n' +
    '1. Вкладка «Сделки». Это доска: колонки — этапы, карточки — клиенты.\n' +
    '2. Откройте Игоря Ковалёва (этап «Новая заявка»).\n' +
    '3. Нажмите «Далее: Связались» и напишите комментарий своими словами, например «бюджет до 9 млн, однушка, Московский, ипотека». Запись звонка можно приложить, но не обязательно.\n' +
    '4. Дальше назначьте встречу, затем «Встреча прошла»: ответьте на вопросы ИИ. Посмотрите, что ИИ поменял в запросе клиента.\n' +
    '5. На компьютере попробуйте перетащить карточку на доске в следующую колонку.', f => {
    scale(f, 'Насколько этапы совпадают с вашей реальной работой?', 'Совсем не так', 'Один в один');
    text(f, 'Каких этапов не хватает или какие лишние?');
    text(f, 'Какие обязательные поля при переходе мешали бы в реальной работе?');
    text(f, 'Вы записываете звонки с клиентами? Стали бы прикладывать запись к сделке?');
  });

  block(4, 'Подбор и бронь квартиры', 5, LOGIN + '\n\n' +
    '1. Вкладка «Объекты». В «Ещё фильтры» → «Подставить запрос из сделки» выберите Анну Смирнову.\n' +
    '2. Поменяйте цену, комнаты, район. Переключите «Список» и «Карта».\n' +
    '3. Откройте любой ЖК: шахматка квартир, нажмите на свободную, посмотрите планировку.\n' +
    '4. В карточке квартиры выберите сделку и нажмите «Забронировать», заполните форму брони.', f => {
    scale(f, 'Удобно ли этим пользоваться прямо при клиенте?', 'Неудобно', 'Удобно');
    text(f, 'Чего не хватает в карточке ЖК или квартиры?');
    text(f, 'Как сейчас отслеживаете брони и сроки? Бывало, что бронь сгорела?');
  });

  block(5, 'Выставить квартиру на продажу', 4, LOGIN + '\n\n' +
    '1. Вкладка «Объекты», кнопка «+ Выставить на продажу».\n' +
    '2. Нажмите «Вставить пример», затем «Заполнить через ИИ». Или опишите квартиру своими словами.\n' +
    '3. По желанию: 1–2 фото, любой файл как выписка ЕГРН, дом на карте.\n' +
    '4. Нажмите «Сгенерировать» текст объявления, затем «Опубликовать». Публикация имитируется, никуда не уходит.', f => {
    scale(f, 'Подходит ли сгенерированный текст для Авито и Циана?', 'Переписывать целиком', 'Публикую как есть');
    f.addMultipleChoiceItem().setTitle('Сколько времени у вас сейчас уходит на одно объявление?')
      .setChoiceValues(['До 15 минут', '15–30 минут', '30–60 минут', 'Больше часа']);
    text(f, 'Чего не хватает в форме объявления?');
  });

  block(6, 'Рабочий день агента', 4, LOGIN + '\n\n' +
    '1. Вкладка «Задачи»: список дел на сегодня, в нём же подсказки ИИ (истёкшая бронь, давно не связывались). Отметьте любую задачу выполненной.\n' +
    '2. Откройте любую сделку: «Позвонить» (на телефоне откроется звонилка, звонить не нужно), «Связался сегодня», «Черновик сообщения».\n' +
    '3. Вкладка «Брони»: продлите истёкшую бронь Михаила Волкова.\n' +
    '4. Вкладка «Комиссии» заполняется, когда сделка доходит до «Сделка состоялась». По желанию доведите сделку Волкова и выставьте счёт.\n' +
    '5. Нажмите на аватар сверху: личный кабинет и настройки.', f => {
    scale(f, 'Помогает ли список дел и подсказки не терять клиентов и брони?', 'Нет', 'Очень');
    scale(f, 'Отправили бы клиенту черновик сообщения от ИИ?', 'Нет', 'Как есть');
    text(f, 'Как сейчас отслеживаете комиссию от застройщика или продавца? Были задержки или забытые счета?');
    text(f, 'Что было непонятно или лишнее на этих экранах?');
  });

  block(7, 'Для руководителей', 4, 'Агентам блок можно пропустить.\n\nСайт: ' + SITE + '\n' +
    'Вход: «Войти» → «Олег Савин, руководитель отдела продаж» (пароль demo). Сменить пользователя: аватар сверху → «Выйти».\n\n' +
    '1. Вкладка «Команда»: что происходит у каждого агента.\n' +
    '2. Вкладка «Сделки»: фильтр по сотруднику.\n' +
    '3. «Настроить этапы»: переименуйте или добавьте этап, выберите, что агент обязан заполнить при переходе.', f => {
    scale(f, 'Хватает ли руководителю контроля над командой?', 'Нет', 'Полностью');
    text(f, 'Что вы смотрите про агентов каждый день, а здесь этого нет?');
    text(f, 'Кто у вас решает, какую CRM покупать?');
  });

  block(8, 'Итоги', 3, 'Сайт открывать не нужно. Ответьте после того, как прошли хотя бы пару блоков.', f => {
    f.addScaleItem().setTitle('Насколько вероятно, что вы посоветуете Realtika коллеге?')
      .setBounds(0, 10).setLabels('Точно нет', 'Точно да').setRequired(true);
    text(f, 'Какие 2–3 функции самые полезные?');
    text(f, 'Чего не хватает, чтобы вы начали ей пользоваться?');
    scale(f, 'Удобно ли пользоваться с телефона?', 'Неудобно', 'Удобно');
    f.addTextItem().setTitle('Сколько агентство платит за CRM сейчас, за одного агента в месяц?');
    f.addMultipleChoiceItem().setTitle('Сколько готовы платить за такую CRM за одного агента в месяц?')
      .setChoiceValues(['До 500 ₽', '500–1000 ₽', '1000–2000 ₽', 'Больше 2000 ₽', 'Не стал бы платить']);
    text(f, 'Какую одну вещь в работе агента вы убрали бы навсегда?');
    f.addTextItem().setTitle('Можно связаться с вами для 15-минутного звонка по итогам? Оставьте контакт');
  });

  // Ссылки на формы — в документ с инструкцией вместо {{БЛОК N}}
  try {
    const body = DocumentApp.openById(TEST_DOC_ID).getBody();
    links.forEach(l => {
      const found = body.findText('\\{\\{БЛОК ' + l.n + '\\}\\}');
      if (!found) return;
      const el = found.getElement().asText();
      el.deleteText(found.getStartOffset(), found.getEndOffsetInclusive());
      el.insertText(found.getStartOffset(), l.url);
      el.setLinkUrl(found.getStartOffset(), found.getStartOffset() + l.url.length - 1, l.url);
    });
  } catch (e) { Logger.log('Не смог обновить документ, вставьте ссылки вручную: ' + e); }

  links.forEach(l => Logger.log('Блок ' + l.n + ' · ' + l.title + ': ' + l.url + '  (редактировать: ' + l.edit + ')'));
  Logger.log('Таблица ответов (по листу на блок): ' + sheet.getUrl());
}
